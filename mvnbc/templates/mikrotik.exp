#!/usr/bin/expect -f

set IP      [lindex $argv 0]
set USER    [lindex $argv 1]
set PASS    [lindex $argv 2]
set OUTFILE [lindex $argv 3]
set PORT    [lindex $argv 4]
set CONNTIMEOUT [lindex $argv 5]

if {$PORT eq ""} { set PORT 22 }
if {$CONNTIMEOUT eq ""} { set CONNTIMEOUT 15 }

set timeout 180

# Write session output to backup file
log_file -noappend $OUTFILE

# Dumb terminal: stops RouterOS 7 probing the terminal for capabilities
# (ESC[9999B / ESC[6n sequences) and keeps output plain for log_file.
set env(TERM) "dumb"

# Direct SSH to LAN IP — no WireGuard/tunnel required.
# ConnectTimeout keeps LAN failures fast instead of hanging.
spawn ssh -o StrictHostKeyChecking=no -o ConnectTimeout=$CONNTIMEOUT -p $PORT $USER@$IP

# Wide pty so long `/export terse` lines are not wrapped mid-word by the
# terminal layer (which would corrupt single-line commands). Best effort.
catch {stty cols 300 rows 60 < $spawn_out(slave,name)}

# Login
expect {
    "*yes/no*" {
        send "yes\r"
        exp_continue
    }

    "*assword:*" {
        send "$PASS\r"
    }

    timeout {
        puts "SSH CONNECTION TIMEOUT"
        exit 1
    }

    eof {
        puts "SSH CONNECTION FAILED"
        exit 1
    }
}

# Wait for RouterOS prompt
expect {
    -re {\[.*@.*\][[:space:]]*[>#]} {}

    "*Login failed*" {
        puts "LOGIN FAILED"
        exit 1
    }

    "*incorrect*" {
        puts "LOGIN FAILED"
        exit 1
    }

    timeout {
        puts "LOGIN TIMEOUT"
        exit 1
    }
}

# Sync prompt
send "\r"

expect {
    -re {\[.*@.*\][[:space:]]*[>#]} {}

    timeout {
        puts "PROMPT SYNC TIMEOUT"
        exit 1
    }
}


# Export configuration (show-sensitive on ROSv7, fallback to plain terse on old ROS)
send "/export show-sensitive terse\r"

expect {
    -re {expected end of command|bad command name|no such command} {
        send "/export terse\r"
        expect {
            -re {\[.*@.*\][[:space:]]*[>#]} {}

            timeout {
                puts "EXPORT TIMEOUT"
                exit 1
            }
        }
    }

    -re {\[.*@.*\][[:space:]]*[>#]} {}

    timeout {
        puts "EXPORT TIMEOUT"
        exit 1
    }
}

# Stop logging BEFORE quitting
log_file

# Small delay to flush output
after 500

send "/quit\r"

expect eof
