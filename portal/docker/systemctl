#!/bin/bash
# DARKVEDA LAB systemctl compatibility shim (docker builds only).
# The portal was written against host systemd. Inside the container the same
# unit names map to local equivalents. Unknown units fall through to the real
# systemctl (which reports "not booted" as usual). NOT for host use.
REAL=/bin/systemctl
SUPER_REMOTE="http://127.0.0.1:9001"

cmd="${1:-}"; unit="${2:-}"

sup_state() { # $1 = @remote for netstack supervisor, rest = program names; active only if ALL RUNNING
    local out progs n
    if [ "$1" == "@remote" ]; then shift
        out=$(supervisorctl -s "$SUPER_REMOTE" status "$@" 2>/dev/null) || { echo unknown; return; }
    else
        out=$(supervisorctl status "$@" 2>/dev/null) || { echo unknown; return; }
    fi
    progs=$#; n=$(echo "$out" | grep -c "RUNNING")
    if [ "$n" -ge "$progs" ] && [ "$progs" -gt 0 ]; then echo active; else echo inactive; fi
}

case "$cmd" in
    restart)
        case "$unit" in
            wg-quick@*) iface="${unit#wg-quick@}"; wg-quick down "$iface" && wg-quick up "$iface" ;;
            smbd) supervisorctl restart smbd ;;
            darkveda-lab|wg-monitor) supervisorctl restart portal ;;
            *) exec "$REAL" "$@" ;;
        esac
        ;;
    start|stop)
        case "$unit" in
            wg-quick@*) iface="${unit#wg-quick@}"
                if [ "$cmd" = "start" ]; then wg-quick up "$iface"; else wg-quick down "$iface"; fi ;;
            smbd) supervisorctl "$cmd" smbd ;;
            darkveda-lab|wg-monitor) supervisorctl "$cmd" portal ;;
            *) exec "$REAL" "$@" ;;
        esac
        ;;
    is-active)
        case "$unit" in
            wg-quick@*) out=$(ip link show "${unit#wg-quick@}" 2>/dev/null) || { echo inactive; }
                if [ -n "$out" ]; then echo "$out" | grep -q "state DOWN" && echo inactive || echo active; fi ;;
            smbd) sup_state smbd ;;
            networking) ip route show default | grep -q . && echo active || echo inactive ;;
            darkveda-lab|wg-monitor) sup_state portal ;;
            *) exec "$REAL" "$@" ;;
        esac
        ;;
    is-enabled)
        case "$unit" in
            wg-quick@*|smbd|networking|darkveda-lab|wg-monitor)
                echo enabled ;;
            *) exec "$REAL" "$@" ;;
        esac
        ;;
    enable|disable)
        case "$unit" in
            wg-quick@*|smbd|networking|darkveda-lab|wg-monitor)
                echo "autostart is static in docker mode (supervisord); $cmd ignored for $unit" >&2; exit 1 ;;
            *) exec "$REAL" "$@" ;;
        esac
        ;;
    daemon-reload)
        exit 0 ;;
    *)
        exec "$REAL" "$@" ;;
esac
