# =============================================================
# DARKVEDA LAB demo settings — copy to .env and review first:
#   cp .env.example .env
# Demo logins are intentionally EASY (admin/admin). This repo is for
# learning/sharing — change every password before any real use.
# =============================================================

# Timezone (PHP date strings, container TZ)
APP_TZ=UTC

# --- Portal :8090 ------------------------------------------------
# First boot creates portal login admin/admin (change via /password).
# No variable needed; shown here to document the default.

# --- IPAM :8091 --------------------------------------------------
APP_PORT=8091
APP_DEBUG=false
# IPAM needs >= 10 chars, so its demo login is admin / adminadmin
# (closest memorable value). Change it in IPAM > Users after login.
ADMIN_PASSWORD=adminadmin

# --- Samba (file shares, served by the portal container) ---------
# First boot creates Samba user admin/admin. Change with:
#   docker exec darkveda-portal bash -c 'echo -e "NEWPASS\nNEWPASS" | smbpasswd -s admin'
# (also update any saved client credentials afterwards)

# --- Database (MariaDB, loopback-only, no LAN exposure) -----------
DB_NAME=darkveda_ipam
DB_USER=darkveda
DB_PASS=darkveda-demo-change-me
DB_ROOT_PASS=darkveda-root-change-me

# --- WireGuard server (netstack renders on first boot) ------------
WG_ADDR=10.99.0.1/24
WG_PORT=51820

# --- Service network (VPS side, advertised over BGP) --------------
BR10_ADDR=192.168.10.1/24

# --- BGP (FRR, rendered on first boot) -----------------------------
BGP_AS=65001
BGP_ROUTER_ID=10.99.0.1
BGP_PEER=10.99.0.2
BGP_PEER_AS=65002
ORIGIN_NET=192.168.10.0/24
HOME_NETS=172.16.0.0/24,172.16.30.0/24

# --- Zabbix (optional, or fill in IPAM > Monitoring later) --------
# Create a read-only API token: Zabbix > Users > API tokens.
ZABBIX_URL=
ZABBIX_TOKEN=
ZABBIX_VERIFY_TLS=true
