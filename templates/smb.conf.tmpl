# DARKVEDA LAB — Samba (rendered/copied on first boot; managed via portal after)
# Default share [sharelab] for user admin (read & write). Per-user write
# control via `write list`; daemons access files as the connecting user,
# enforced by filesystem ACLs. Folder: ./sharelab on host (/DATA/sharelab).
[global]
   workgroup = WORKGROUP
   server string = DARKVEDA LAB file server
   server role = standalone server
   disable netbios = yes
   obey pam restrictions = yes
   unix password sync = yes
   passwd program = /usr/bin/passwd %u
   passwd chat = *Enter\snew\s*\spassword:* %n\n *Retype\snew\s*\spassword:* %n\n *password\supdated\ssuccessfully* .
   pam password change = yes
   map to guest = bad user
   log file = /var/log/samba/log.%m
   max log size = 1000
   logging = file
   panic action = /usr/share/samba/panic-action %d

# Open access: reachable from any IP (auth still via valid users).
[sharelab]
   path = /DATA/sharelab
   comment = DARKVEDA LAB default share
   browseable = yes
   read only = yes
   valid users = admin
   write list = admin
   create mask = 0664
   directory mask = 0775
