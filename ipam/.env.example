# ---------------------------------------------------------------
# DarkVeda IPAM — copy to .env and edit before `docker compose up`
#   cp .env.example .env
# ---------------------------------------------------------------

# Port the web UI is published on
APP_PORT=8080

# Timezone (see https://www.php.net/manual/en/timezones.php)
APP_TZ=UTC

# Set to true only while debugging — leaks stack traces otherwise
APP_DEBUG=false

# --- First admin login (DARKVEDA LAB demo build) -------------------
# Demo default is admin / adminadmin (the app requires >= 10 characters,
# so plain admin/admin is rejected here). CHANGE IT after first login
# via Users page. It is only read at container start.
ADMIN_PASSWORD=adminadmin

# --- Database --------------------------------------------------
# Generate strong values, e.g.:  openssl rand -base64 24
DB_NAME=darkveda_ipam
DB_USER=darkveda
DB_PASS=darkveda
DB_ROOT_PASS=darkveda

# Use an external database instead of the bundled one by setting
# DB_HOST to its address and removing the `db` service.
DB_HOST=db
DB_PORT=3306

# --- Zabbix (optional) -----------------------------------------
# Leave blank to configure later from the Monitoring page.
# Create a read-only API token: Zabbix -> Users -> API tokens
ZABBIX_URL=
ZABBIX_TOKEN=
ZABBIX_VERIFY_TLS=true
